# Bot token created with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Chat ID that receives alerts (see the Telegram setup section in README.md)
TELEGRAM_CHAT_ID=

# HTTP server configuration
API_HOST=127.0.0.1
API_PORT=3333

# Frontend origin allowed to access the API
WEB_ORIGIN=http://localhost:5173

# Supabase Postgres. Use a session pooler URL if direct IPv6 is unavailable.
DATABASE_URL=
# Prefer a direct URL for migrations; a session pooler also works when direct IPv6 is unavailable.
MIGRATION_DATABASE_URL=

# Supabase Auth project URL and public key. Never put a service_role/secret key in VITE_*.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Shared secret used only by the bot to send jobs to POST /internal/jobs
INGESTION_TOKEN=

# Public URL of the deployed API, used by the bot outside local development
API_URL=http://localhost:3333

# Optional public API URL used by the production Vite build. Local Vite uses /api proxy.
VITE_API_URL=
